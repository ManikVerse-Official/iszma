[TEMPLATE]
# ---------------------------------------------------------------------------
# Supabase (required for auth, storage and the secure card/ledger flow)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Admin sign-in needs NO client-side configuration.
#   • the credential lives in the `admin_users` table as a bcrypt hash
#   • the `admin-login` Edge Function verifies it and returns a session
# See SECURITY_STEP14.md. Never add VITE_ADMIN_EMAIL / VITE_ADMIN_PASSWORD:
# anything prefixed with VITE_ is compiled into the public bundle.

# ---------------------------------------------------------------------------
# Firebase (legacy, unused by the greeting flow)
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# India -> Razorpay (UPI, PhonePe, Google Pay, Amazon Pay, BHIM, netbanking,
# cards, wallets). The METHOD_* switches in your Razorpay dashboard decide which
# of these are shown; the app requests upi/card/netbanking/wallet/paylater.
VITE_RAZORPAY_KEY_ID=
# Outside India -> PayPal and/or Stripe. Both accept payments worldwide and can
# settle to an Indian business bank account:
#   • PayPal India business account → auto-withdraws to your linked Indian bank.
#   • Stripe India account → payouts to your Indian bank account.
# Add both keys to offer a choice; the buyer picks Stripe or PayPal at checkout.
VITE_PAYPAL_CLIENT_ID=
# Presence of this key enables the Stripe option for international buyers.
VITE_STRIPE_PUBLISHABLE_KEY=
# Set to "demo" to test the full greeting flow without a real transaction.
# The server also honours a PAYMENT_MODE=demo Edge Function secret.
VITE_PAYMENT_MODE=

# ---------------------------------------------------------------------------
# Greeting Cards
# ---------------------------------------------------------------------------
# Photo uploads go through the `upload-image` Edge Function, so the image-host
# key is a backend secret (IMGBB_API_KEY below) and is never a VITE_ variable.
# Leave empty to share cards as <your-domain>/greet/<id>.
# Set it (e.g. ishmaverse.com) to give every card its own subdomain: <id>.ishmaverse.com
VITE_GREETING_DOMAIN=

# ---------------------------------------------------------------------------
# Edge Function secrets (set with `supabase secrets set`, NEVER in .env here)
# ---------------------------------------------------------------------------
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox
# Stripe (international). Use sk_live_… / sk_test_… here, never in the client.
# STRIPE_SECRET_KEY=
# PAYMENT_MODE=demo

# Image hosting for the photos attached to greeting cards. Used only by the
# `upload-image` Edge Function; the browser never receives this key.
# IMGBB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email — bills, receipts and plan notices are sent through Resend.
# Create a key at https://resend.com/api-keys then verify your sending domain.
# RESEND_API_KEY=re_xxxxxxxx
# RECEIPT_FROM_EMAIL=Ishmaverse <receipts@yourdomain.com>
# Company logo printed on every bill/receipt (defaults to <site>/ishmaverse.png).
# BRAND_LOGO_URL=https://ishmaverse.com/ishmaverse.png
# Reply-to shown in every email footer.
# SUPPORT_EMAIL=support@ishmaverse.com
#
# ReportCard Studio — who gets unlimited free access and admin copies.
# ADMIN_EMAILS=admin@ishmaverse.com,you@school.com
# ADMIN_IPS=203.0.113.7
# ADMIN_NOTIFY_EMAIL=admin@ishmaverse.com
#
# Shared secret the daily subscription-maintenance cron must present.
# MAINTENANCE_SECRET=<long-random-string>
#
# CORS allowlist for every Edge Function (comma-separated, no trailing slash).
# REQUIRED before deploying: a browser call from an origin that is not listed
# here receives no Access-Control-Allow-Origin header and is blocked. Localhost
# dev origins are always allowed so `npm run dev` can reach the deployed
# functions. Replaces the old wildcard (`Access-Control-Allow-Origin: *`).
# SITE_ORIGINS=https://ishmaverse.com,https://www.ishmaverse.com
# RENEWAL_WARN_DAYS=7

# Public origin used to build the "Manage or delete your card" link in emails.
# Falls back to https://ishmaverse.com when unset.
# PUBLIC_SITE_URL=https://ishmaverse.com

# ---------------------------------------------------------------------------
# ReportCard Studio
# ---------------------------------------------------------------------------
# Where the "Open ReportCard Studio" button in the admin dashboard points.
# Leave empty to use the same-origin /reportcard path.
VITE_REPORTCARD_URL=

# Audience analytics uses arbitrary visitor-hash salt set as an Edge Function
# secret (VISIT_HASH_SALT), NOT here. No client key is needed.
