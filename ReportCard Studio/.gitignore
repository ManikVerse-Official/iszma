# ---------------------------------------------------------------------------
# Build & test output (regenerated by the scripts, never committed)
# ---------------------------------------------------------------------------
.tmpbuild
dist
node_modules
*.tsbuildinfo

# `tsc -b` emits the compiled vite config next to the source; Vite would then
# load the stale .js instead of vite.config.ts, so it is kept out of git.
vite.config.js
vite.config.d.ts

# Environment — never commit real secrets (the .example is safe to share)
.env
.env.*
!.env.example
