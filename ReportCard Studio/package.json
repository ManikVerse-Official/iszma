{
  "name": "reportcard-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:embed": "node scripts/build-embed.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "npx --no-install jiti scripts/regression-test.ts",
    "test:pipeline": "npx --no-install jiti scripts/pipeline-test.ts",
    "test:preview": "esbuild scripts/render-preview.tsx --bundle --platform=node --format=cjs --outfile=.tmpbuild/render-preview.cjs --jsx=automatic && node .tmpbuild/render-preview.cjs",
    "test:browser": "node scripts/browser-test.cjs",
    "test:browser-photos": "node scripts/browser-test-photos.cjs",
    "icons": "node scripts/generate-icons.mjs",
    "test:data": "node scripts/generate-layout-stress.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.437.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.63.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3",
    "vite": "^5.4.1"
  }
}
